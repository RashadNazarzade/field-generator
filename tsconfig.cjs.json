{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",

    "outDir": "./dist/cjs",
    "rootDir": "./src",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true,

    "baseUrl": ".",
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests/**/*",
    "benchmarks/**/*"
  ]
}
