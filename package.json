{
  "name": "@glitchproof/form-field-generator",
  "version": "1.2.0",
  "description": "> Type-safe field path generation for nested objects and arrays",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clear:dist": "rm -rf dist",
    "type-check": "tsc --noEmit --project tsconfig.type-check.json",
    "test": "bun run clear:dist && bun run cache-clear:test && vitest run ",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cache-clear:test": "vitest --clearCache",
    "format": "prettier --write .",
    "format:check": "prettier --check \"./src/**/*.ts\"",
    "validate": "bun run format:check && bun run type-check && bun run test",
    "ci": "bun run format && bun run type-check && bun run test && bun run build",
    "prepublishOnly": "bun run ci",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "safe:release": "bun run ci && changeset version && changeset publish",
    "bench": "vitest bench tests/performance"
  },
  "keywords": [
    "react-hook-form",
    "field-path",
    "fields-path-generator"
  ],
  "author": {
    "name": "GlitchTruth",
    "url": "https://github.com/RashadNazarzade"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RashadNazarzade/field-generator.git"
  },
  "files": [
    "dist",
    "!dist/__test__",
    "!dist/tests",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "expect-type": "^1.3.0",
    "performance-now": "^2.1.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "bugs": {
    "url": "https://github.com/RashadNazarzade/field-generator/issues"
  },
  "homepage": "https://github.com/RashadNazarzade/field-generator#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.3.0"
}
